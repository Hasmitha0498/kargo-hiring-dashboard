# Copy this file to .env.local and fill in real values. NEVER commit .env or .env.local.
# On Vercel, set the same names under Project Settings -> Environment Variables.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Server-side only. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Model used for calibration, scoring and drafting. Default: gemini-3.5-flash
GEMINI_MODEL=
# Optional: model tried if the main one is overloaded, rate-limited or unavailable. Default: gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=
# Sender, e.g. "Kargo Hiring <hiring@yourdomain.com>". Without a verified domain use onboarding@resend.dev
# (Resend then only delivers to your own account email, so set RESEND_TEST_EMAIL to that address).
RESEND_FROM_EMAIL=
# TEST MODE: when set, EVERY email goes to this inbox instead of the candidate. Leave set during demos.
RESEND_TEST_EMAIL=

# --- Optional email signature ---
COMPANY_NAME=Kargo
SENDER_NAME=Arjun Mehta
SENDER_TITLE=Founder
